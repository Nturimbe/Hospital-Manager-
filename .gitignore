# ================================================================
# HOSPITAL MANAGEMENT SYSTEM
# Git Ignore Rules
#
# Purpose:
# Keep generated files, machine-specific files, local configuration,
# secrets, logs, and temporary artifacts out of version control.
#
# IMPORTANT:
#   - Example configuration files are intentionally tracked.
#   - Real local configuration and secrets are intentionally ignored.
#   - Do not add a file to this list merely because it is convenient;
#     tracked files should represent intentional project source/config.
# ================================================================


# ----------------------------------------------------------------
# .NET / ASP.NET Core
# ----------------------------------------------------------------
# Build outputs generated by the .NET SDK and MSBuild.
**/bin/
**/obj/

# User-specific Visual Studio / .NET files.
*.user
*.userosscache
*.suo
*.rsuser

# Visual Studio solution metadata/cache.
.vs/

# Local ASP.NET Core development configuration.
# The real development file may contain connection strings, credentials,
# signing keys, or other machine-specific settings.
**/appsettings.Development.json


# ----------------------------------------------------------------
# Node.js / React / TypeScript
# ----------------------------------------------------------------
# Installed dependencies are restored from package manifests and must
# not be committed to the repository.
**/node_modules/

# Frontend build output.
**/dist/
**/build/

# TypeScript incremental build metadata.
**/*.tsbuildinfo

# Package-manager debug logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ----------------------------------------------------------------
# Local environment files and secrets
# ----------------------------------------------------------------
# Real environment files may contain passwords, tokens, API keys,
# database credentials, JWT signing keys, or other secrets.
.env
.env.*

# Example environment files are safe templates and are intentionally
# committed so another developer can reproduce the required variables.
!.env.example
!**/.env.example


# ----------------------------------------------------------------
# IDE / editor-specific files
# ----------------------------------------------------------------
# Local VS Code workspace state/extensions/settings are machine-specific
# unless the team deliberately decides to version a particular setting.
.vscode/

# Other common editor metadata.
.idea/
*.iml


# ----------------------------------------------------------------
# Logs
# ----------------------------------------------------------------
*.log
**/logs/


# ----------------------------------------------------------------
# Temporary files and operating-system artifacts
# ----------------------------------------------------------------
# Generic temporary directories/files created by local tools or scripts.
**/tmp/
**/temp/
*.tmp
*.temp

# Windows Explorer / macOS filesystem metadata.
Thumbs.db
Thumbs.db:encryptable
.DS_Store

# Common editor backup/swap files.
*.swp
*.swo
*~


# ----------------------------------------------------------------
# Local test / coverage output
# ----------------------------------------------------------------
# Generated test and coverage reports should be reproducible rather than
# stored as source-controlled project files.
**/TestResults/
**/coverage/
*.coverage
*.coveragexml


# ----------------------------------------------------------------
# Local archives / generated packages
# ----------------------------------------------------------------
# Prevent accidental commits of locally generated application packages.
*.zip
*.tar
*.tar.gz
*.tgz

# Local SQLite dev database
*.db
