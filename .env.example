# Copy this file to '.env' and fill in real local values.
# .env itself must NEVER be committed (it is listed in .gitignore).

# SQL Server 'sa' (administrator) password for the LOCAL database container only.
# SQL Server rejects weak passwords. It must be at least 8 characters and
# contain at least 3 of these 4 kinds: uppercase, lowercase, digit, symbol.
# Example of a valid shape: Local_Dev_Pass_2026 (uppercase + lowercase + digit + symbol)
SQL_SA_PASSWORD=Replace_With_A_Strong_Local_Password_1

# Secret key used to sign JWT login tokens, LOCAL use only.
# Use a long random string (at least 32 characters).
JWT_SIGNING_KEY=Replace_With_A_Long_Random_Local_Only_String
